# Text AI Provider (OpenAI-compatible /v1/chat/completions)
TEXT_PROVIDER_BASE_URL=https://api.openai.com/v1
TEXT_PROVIDER_API_KEY=sk-xxx
TEXT_PROVIDER_MODEL=gpt-4o

# Image AI Provider (OpenAI-compatible /v1/images/generations)
IMAGE_PROVIDER_BASE_URL=https://api.openai.com/v1
IMAGE_PROVIDER_API_KEY=sk-xxx
IMAGE_PROVIDER_MODEL=dall-e-3

# Pexels Free Stock Photo Provider (Alternative / Fallback)
# Get your free API key at https://www.pexels.com/api/
PEXELS_API_KEY=
# Options: 'auto' (AI with Pexels fallback), 'ai' (AI only), 'pexels' (Pexels only)
IMAGE_SOURCE=auto

# App Config
MAX_FILE_SIZE_MB=10

# App Store SSO
# Set false for local development without an App Store launch.
# Production requires true plus the shared secret configured in Vercel.
APPSTORE_AUTH_ENABLED=false
APPSTORE_SHARED_SECRET=
APPSTORE_AUDIENCE=presentation-maker
APPSTORE_ALLOWED_CLOCK_SKEW_SECONDS=20
APPSTORE_MAX_TOKEN_TTL_SECONDS=900
APPSTORE_SESSION_MAX_AGE_SECONDS=3600
APPSTORE_COOKIE_SAMESITE=lax
APPSTORE_COOKIE_SECURE=false
APPSTORE_COOKIE_DOMAIN=
